# =============================================
# AIO TESTS MCP SERVER
# =============================================
# Copy to .env and fill in the values for your deployment.

# --- Atlassian Cloud ---
# AIO Tests access token. Generate it in Jira: AIO Tests > (?) icon > API Access Token.
# Setting this alone is enough; JIRA_URL is not required on Cloud, because the
# token identifies your tenant.
AIO_API_TOKEN=your_aio_access_token

# --- Jira Server / Data Center ---
# On Server/DC the AIO Tests API is served from your Jira base URL and reuses the
# Jira credentials, so it must be enabled explicitly.
#AIO_ENABLED=true
#JIRA_URL=https://jira.your-company.com
# Personal Access Token (recommended)...
#JIRA_PERSONAL_TOKEN=your_pat
# ...or basic auth.
#JIRA_USERNAME=your_username
#JIRA_API_TOKEN=your_password_or_token

# Optional: use dedicated AIO credentials instead of the JIRA_* ones.
#AIO_PERSONAL_TOKEN=your_pat
#AIO_USERNAME=your_username
#AIO_PASSWORD=your_password

# --- Server behaviour ---
# Hide every write tool (create/update).
#READ_ONLY_MODE=true
# Expose only these tools (comma-separated, default: all).
#ENABLED_TOOLS=aio_get_project,aio_search_test_cases,aio_get_test_case
# Verbose logging.
#MCP_VERBOSE=true
#MCP_LOGGING_STDOUT=false

# --- Advanced ---
# Override the API base URL (defaults to the AIO Tests Cloud API, or
# {JIRA_URL}/rest/aio-tcms-api/1.0 for Server/Data Center).
#AIO_URL=https://tcms.aiojiraapps.com/aio-tcms/api/v1
#AIO_SSL_VERIFY=true
#AIO_HTTP_PROXY=http://aio-proxy.example.com:8080
#AIO_HTTPS_PROXY=https://aio-proxy.example.com:8443
#AIO_SOCKS_PROXY=socks5://aio-proxy.example.com:1080
#AIO_NO_PROXY=localhost,127.0.0.1
#AIO_CUSTOM_HEADERS=X-Aio-Service=mcp-integration
#AIO_CLIENT_CERT=/path/to/client.pem
#AIO_CLIENT_KEY=/path/to/client.key
