# Copy to .env beside this file and fill in. The .env is gitignored: keep every
# host-specific value here and out of the repository.

# Public hostname Traefik routes, and the path prefix the server sits under.
# The MCP endpoint is then http://$MCP_HOST$PATH_PREFIX/mcp
MCP_HOST=mcp.example.com
PATH_PREFIX=/aio-tests

# The external Docker network Traefik watches, and its HTTP entrypoint.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=web

# Where deploy.sh reaches Traefik on this host to check /healthz.
TRAEFIK_URL=http://127.0.0.1

# Env file with JIRA_URL and the Jira credentials. Keep it outside the checkout.
JIRA_ENV_FILE=/path/to/jira.env

# Optional overrides; see docker-compose.yml.
# AIO_API_TOKEN=
# ENABLED_TOOLS=
# READ_ONLY_MODE=false

# IMAGE_TAG and PREVIOUS_IMAGE_TAG are appended and maintained by deploy.sh.
